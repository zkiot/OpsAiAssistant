# 复制为 .env 后按实际环境填写，.env 本身不要提交到git

APP_NAME=AI运维助手
DEBUG=false
LOG_LEVEL=INFO

# DeepSeek LLM
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 本地 embedding 服务 (TEI + BGE-M3)
EMBEDDING_SERVICE_URL=http://127.0.0.1:8001

# Milvus 向量库
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=ops_knowledge

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_ops_assistant

# Redis（会话记忆）
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

CMDB_API_URL=http://your-cmdb-platform/api
CMDB_USE_MOCK=true

# app/core/config.py（追加）
MONITOR_API_URL: str = ""
MONITOR_USE_MOCK: bool = True
